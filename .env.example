# Template de variáveis de ambiente — SEGURO de commitar (sem valores reais).
# Copie para `.env` (que está no .gitignore) e preencha com os valores ROTACIONADOS.
#
# ATENÇÃO: a JVM NÃO lê este arquivo sozinha. Duas opções:
#   1) (recomendado) IntelliJ > Run > Edit Configurations > Environment variables
#   2) adicionar a lib dotenv-kotlin e empurrar os valores no início do main()

# Chave de assinatura dos JWT. Gere 32+ bytes aleatórios, ex.:
#   openssl rand -base64 32
JWT_SECRET=GERE_UMA_CHAVE_NOVA_ALEATORIA_32_BYTES

# Banco de dados
DB_URL=jdbc:mysql://localhost:3306/koin
DB_USER=root
DB_PASSWORD=
